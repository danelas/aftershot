# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # worker only — never ship to the browser

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDING=          # $79/mo price id
STRIPE_PRICE_STANDARD=          # $99-149/mo price id

# Email (Resend)
RESEND_API_KEY=
REMINDER_FROM_EMAIL=hello@aftershot.app

# Web push (VAPID) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@aftershot.app

# Posting — v1 via upload-post.com; swap to direct APIs as approved
UPLOAD_POST_API_KEY=

# Worker
PUBLIC_BASE_URL=https://aftershot.app
