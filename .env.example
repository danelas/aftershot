# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # worker only — never ship to the browser

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=           # optional — $49/mo price id; auto-created by lookup_key aftershot_monthly_49 if unset

# Email (Resend)
RESEND_API_KEY=
REMINDER_FROM_EMAIL=hello@theaftershot.com

# Web push (VAPID) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@theaftershot.com

# Posting — v1 via upload-post.com; swap to direct APIs as approved
UPLOAD_POST_API_KEY=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
FACEBOOK_PAGE_ID=              # only if a customer posts to a FB page

# Google Places API (New) — live Google rating + review count on reels
GOOGLE_MAPS_API_KEY=          # enable "Places API (New)" on the Google Cloud project

# Worker
PUBLIC_BASE_URL=https://theaftershot.com
AUTOPOST=0                     # 1 = actually publish to real accounts. Keep 0 for render-only tests.

# Social agent — AfterShot's OWN ad, not customer reels (src/social/)
AFTERSHOT_SOCIAL_PROFILE=      # our upload-post profile. No fallback to a customer's on purpose.
SOCIAL_PLATFORMS=instagram,tiktok,youtube
AFTERSHOT_FACEBOOK_PAGE_ID=    # only if the brand posts to a FB page
SOCIAL_POST=0                  # 1 = actually publish the daily ad. Keep 0 for render-only tests.
